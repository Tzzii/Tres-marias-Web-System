# Where the API lives
VITE_API_URL=http://localhost:4000/api
# Services that use the API instead of the browser store (comma-separated). Empty = all on the browser store.
# Flip whole clusters only (docs/backend-development-phases.md §6.3), and keep both portals identical.
# auth (Phase 3): sign-in, sign-up and accounts run on the API, so start it too (npm run dev runs all three).
# catalog (Phase 4): packages, additional charges, buffet dishes, the buffet price per person and the rental price list.
# calendar (Phase 5), reservations (Phase 6), messages (Phase 7) and payments (Phase 8: bank transfers with a receipt photo,
# cash, refunds; the GCash QR of Phase 8B needs the PayMongo keys in apps/api/.env) are switched on together: they read each other's data.
# customers and feedback (Phase 9), inventory and outsource (Phase 10) and reports (Phase 11: Dashboard and Reports) read
# the reservations of the services above, so they were switched on together after Phase 11 (Cluster D): every page uses the API.
VITE_API_SERVICES=auth,catalog,calendar,reservations,messages,payments,customers,feedback,inventory,outsource,reports
