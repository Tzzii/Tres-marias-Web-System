# Settings for the Tres Marias API (read by src/config.js).
# Copy this file to apps/api/.env and fill in the real values there. Never commit .env.

NODE_ENV=development
PORT=4000
# Time zone: always Asia/Manila (fixed in src/config.js, not a setting)

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tres_marias
# If the password contains #, keep it in single quotes: dotenv reads an unquoted # as the start of a comment.
DB_PASSWORD=
DB_NAME=tres_marias

JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_ADMIN_TTL=8h
JWT_CUSTOMER_TTL=12h
JWT_CUSTOMER_REMEMBER_TTL=7d

MAIL_DRIVER=log
MAIL_FROM="Tres Marias Catering <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_NAME=

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Phase 8B — sk_test_… habang dev; sk_live_… sa production lang. Huwag i-commit ang totoong value.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_QR_EXPIRY_SECONDS=1800

CLIENT_URL=http://localhost:5173
