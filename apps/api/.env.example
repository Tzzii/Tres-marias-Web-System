
NODE_ENV=development
PORT=4000

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tres_marias
DB_PASSWORD=
DB_NAME=tres_marias

JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_ADMIN_TTL=8h
JWT_CUSTOMER_TTL=12h
JWT_CUSTOMER_REMEMBER_TTL=7d

MAIL_DRIVER=log
MAIL_FROM="Tres Marias Catering <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_QR_EXPIRY_SECONDS=1800

CLIENT_URL=http://localhost:5173

# Optional Google Web OAuth client ID. No client secret is used for the ID-token flow.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile secret. Create a widget for the customer portal hostname.
TURNSTILE_SECRET_KEY=
DISPOSABLE_EMAIL_DOMAINS=
# Optional Disify key for higher API limits. Anonymous checks work without a key.
DISIFY_API_KEY=

# Budget recommendations. Keep disabled until API credits are available; never use VITE_* for this key.
AI_BUDGET_ENABLED=false
OPENAI_API_KEY=
# Chat and budget recommendations use the same text model; voice has separate audio models.
# Set gpt-6.1-sol here to compare Sol later; restart the API after changing.
AI_TEXT_MODEL=gpt-6-luna
# Optional legacy override; leave blank to follow AI_TEXT_MODEL.
AI_BUDGET_MODEL=
AI_BUDGET_TIMEOUT_MS=20000
AI_BUDGET_MAX_OUTPUT_TOKENS=2000

# Guest/customer AI assistant. Shares OPENAI_API_KEY above, but has independent enable switches and caps.
# Zero budgets keep all paid assistant calls disabled. Amounts are US cents, not Philippine pesos.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_VOICE_ENABLED=false
AI_ASSISTANT_DAILY_QUESTIONS=20
AI_ASSISTANT_DAILY_BUDGET_CENTS=0
AI_ASSISTANT_MONTHLY_BUDGET_CENTS=0
AI_ASSISTANT_VOICE=marin

# Only trust the local Nginx reverse proxy; never set true or a numeric hop count.
TRUST_PROXY=loopback

SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_CUSTOMER_PASSWORD=
