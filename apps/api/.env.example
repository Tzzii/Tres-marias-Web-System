# Settings for the Tres Marias API (read by src/config.js).
# Copy this file to apps/api/.env and fill in the real values there. Never commit .env.
# NODE_ENV=production adds go-live checks: a JWT_SECRET of 32+ random characters, a DB_PASSWORD,
# MAIL_DRIVER=smtp with the business's own MAIL_FROM, a real SMS driver (or ALLOW_SMS_LOG=true),
# and CORS_ORIGINS listing the live portals (https://…, no localhost). The API will not start without them.

NODE_ENV=development
PORT=4000
# Time zone: always Asia/Manila (fixed in src/config.js, not a setting)

# Development only. Production: CORS_ORIGINS=https://tresmarias.ph,https://admin.tresmarias.ph (your domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tres_marias
# If the password contains #, keep it in single quotes: dotenv reads an unquoted # as the start of a comment.
DB_PASSWORD=
DB_NAME=tres_marias

JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_ADMIN_TTL=8h
JWT_CUSTOMER_TTL=12h
JWT_CUSTOMER_REMEMBER_TTL=7d

# log = print every email (and its one-time code) on the API console; smtp = really send it. Production needs smtp.
MAIL_DRIVER=log
MAIL_FROM="Tres Marias Catering <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_NAME=
# Production refuses SMS_DRIVER=log. Until an SMS provider is connected, true lets the live server start
# anyway: no code goes by SMS, and outsourcing requests sent by SMS are only logged (the page says so).
ALLOW_SMS_LOG=false

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Phase 8B — sk_test_… habang dev; sk_live_… sa production lang. Huwag i-commit ang totoong value.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_QR_EXPIRY_SECONDS=1800

CLIENT_URL=http://localhost:5173

# The passwords the seeder (npm run seed:api / seed:starter) gives the accounts it creates. Never in the code
# or the README: the repository is public. The admin password must follow the admin rules (8+ characters,
# upper and lower case, a number); on the live server use a new, strong one.
SEED_ADMIN_PASSWORD=
# Only for npm run seed:api (the sample customers); seed:starter makes no customers.
SEED_CUSTOMER_PASSWORD=
