{
  "name": "tres-marias",
  "version": "1.0.0",
  "private": true,
  "description": "Tres Marias Catering Services - Customer Portal and Admin Dashboard (React + Vite + MUI monorepo).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,client,admin -c yellow,cyan,magenta \"npm:dev:api\" \"npm:dev:client\" \"npm:dev:admin\"",
    "format": "prettier --write \"apps/**/*.{js,jsx,json,css,html}\" \"packages/**/*.{js,jsx,json,css}\" \"scripts/**/*.{js,mjs}\" package.json",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,json,css,html}\" \"packages/**/*.{js,jsx,json,css}\" \"scripts/**/*.{js,mjs}\" package.json",
    "dev:api": "npm run dev -w apps/api",
    "seed:api": "npm run seed -w apps/api",
    "seed:starter": "npm run seed:starter -w apps/api",
    "seed:customers": "npm run seed:customers -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:ping": "npm run db:ping -w apps/api",
    "db:roundtrip": "npm run db:roundtrip -w apps/api",
    "audit:routes": "npm run audit:routes -w apps/api --",
    "test:security": "npm run test:security -w apps/api --",
    "test:realtime": "npm run test:realtime -w apps/api",
    "test:outsource": "npm run test:outsource -w apps/api",
    "test:outsource:db": "npm run test:outsource:db -w apps/api",
    "test:mobile": "npm run test:mobile -w apps/api",
    "test:inventory": "npm run test:inventory -w apps/api",
    "test:labels": "npm run test:labels -w apps/api",
    "test:inventory:db": "npm run test:inventory:db -w apps/api",
    "test:equipment-photos:db": "npm run test:equipment-photos:db -w apps/api --",
    "email:preview": "npm run email:preview -w apps/api",
    "test:email": "npm run test:email -w apps/api",
    "dev:client": "node scripts/vite-run.mjs dev client",
    "dev:client:phone": "node scripts/vite-run.mjs dev client --host",
    "dev:admin": "node scripts/vite-run.mjs dev admin",
    "build": "npm run build:client && npm run build:admin",
    "build:client": "node scripts/vite-run.mjs build client",
    "build:admin": "node scripts/vite-run.mjs build admin",
    "preview:client": "node scripts/vite-run.mjs preview client",
    "preview:admin": "node scripts/vite-run.mjs preview admin",
    "test:booking": "npm run test:booking -w apps/api",
    "test:seed": "npm run test:seed -w apps/api",
    "catalog:update": "npm run catalog:update -w apps/api --",
    "test:booking:db": "npm run test:booking:db -w apps/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.6.2"
  }
}
