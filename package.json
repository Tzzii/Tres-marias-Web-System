{
  "name": "tres-marias",
  "version": "1.0.0",
  "private": true,
  "description": "Tres Marias Catering Services - Customer Portal and Admin Dashboard (React + Vite + MUI monorepo).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,client,admin -c yellow,cyan,magenta \"npm:dev:api\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:api": "npm run dev -w apps/api",
    "seed:api": "npm run seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:ping": "npm run db:ping -w apps/api",
    "db:roundtrip": "npm run db:roundtrip -w apps/api",
    "dev:client": "node scripts/vite-run.mjs dev client",
    "dev:client:phone": "node scripts/vite-run.mjs dev client --host",
    "dev:admin": "node scripts/vite-run.mjs dev admin",
    "build": "npm run build:client && npm run build:admin",
    "build:client": "node scripts/vite-run.mjs build client",
    "build:admin": "node scripts/vite-run.mjs build admin",
    "preview:client": "node scripts/vite-run.mjs preview client",
    "preview:admin": "node scripts/vite-run.mjs preview admin"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
